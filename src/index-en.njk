@media(min-width:901px){.nav aside{align-self:start;padding-top:calc(40*var(--u) + 46px + clamp(40px,min(5vw,8.2vh),96px) * .1)}.nav aside b:first-child{margin-top:0}}

/* hero 1920x1080 */
