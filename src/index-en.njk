.dir{display:grid;grid-template-columns:calc(642*var(--u)) calc(812*var(--u));column-gap:calc(112*var(--u));padding:calc(142*var(--u)) 0 calc(170*var(--u)) calc(119*var(--u) + var(--sx));align-items:start}
