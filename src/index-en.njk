.track{display:flex;gap:calc(32*var(--u));overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;padding:0 calc(128*var(--u) + var(--sx));scroll-padding-inline:calc(128*var(--u) + var(--sx));cursor:grab}.track.drag{cursor:grabbing;scroll-snap-type:none;user-select:none}.track.drag .nc{pointer-events:none}
.track::-webkit-scrollbar{display:none}
.nc{flex:0 0 calc(420*var(--u));height:calc(580*var(--u));scroll-snap-align:start;background:#fff;padding:calc(36*var(--u));display:flex;flex-direction:column;justify-content:space-between;transition:transform .35s,box-shadow .35s}
