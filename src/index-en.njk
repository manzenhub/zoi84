.nav{position:fixed;inset:0;z-index:70;background:var(--or);color:#fff;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:40px;align-items:end;padding:clamp(100px,calc(150*var(--u)),150px) calc(260*var(--u) + var(--sx)) calc(80*var(--u)) calc(128*var(--u) + var(--sx));clip-path:inset(0 0 100% 0);transition:clip-path .7s cubic-bezier(.7,0,.2,1);overflow:auto}
