  group('.clist','li','fu',110,200);
  group('.fcols','.fcols>div','fu',110);
  mark('.fbot','fu',0,200);
  const heads=lp.filter(h=>!h.closest('.hero'));
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const el=e.target;el.classList.add('in');io.unobserve(el);
    const d=parseFloat(el.style.getPropertyValue('--d'))||0;setTimeout(()=>el.style.setProperty('--d','0ms'),d+1600)}),{threshold:.18,rootMargin:'0px 0px -6% 0px'});
  const late=$$('.games .tx .h, .games .tx .over, .games .tx2 p, .games .tx2 .btn');
  // animacije ispod bannera kreću tek kad preloader nestane
  const revealQ=[];const whenReady=f=>revealQ.push(f);
  whenReady(()=>[...heads,...$$('.fu,.fx')].filter(el=>!el.closest('.hero')&&!el.classList.contains('nc')&&!late.includes(el)).forEach(el=>io.observe(el)));
  // naslov o Olimpijskim igrama kreće tek kad se odskrola još ~20% ekrana
  // (rootMargin se ignorira kad je stranica u iframeu, pa se mjeri ručno pri skrolu)
  const lh=$('.games .tx .h');let lateDone=false;
  const chkLate=()=>{if(lateDone||!lh)return;if(lh.getBoundingClientRect().top<innerHeight*.55){lateDone=true;late.forEach(el=>el.classList.add('in'));removeEventListener('scroll',chkLate)}};
  addEventListener('scroll',chkLate,{passive:true});addEventListener('resize',chkLate);whenReady(chkLate);
  const io3=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;io3.unobserve(e.target);e.target.querySelectorAll('.nc').forEach(c=>c.classList.add('in'))}),{threshold:.15});
  whenReady(()=>$$('.track').forEach(t=>io3.observe(t)));
  // elementi s clip-pathom nisu "vidljivi" za IntersectionObserver, pa se prati roditelj
  // fotografije: narančasta ploha pa slika; svaka se otkriva tek kad dođe u ekran (getBoundingClientRect ne ovisi o clip-pathu)
  $$('.im').forEach(el=>el.insertAdjacentHTML('beforeend','<span class="cov" aria-hidden="true"></span>'));
  let pend=$$('.im');
  const chkIm=()=>{if(!pend.length)return;const lim=innerHeight*.88;pend=pend.filter(c=>{const r=c.getBoundingClientRect();if(r.top<lim&&r.bottom>0){c.classList.add('in');const d=parseFloat(c.style.getPropertyValue('--d'))||0;setTimeout(()=>{c.classList.add('done');c.style.setProperty('--d','0ms')},d+1700);return false}return true})};
  addEventListener('scroll',chkIm,{passive:true});addEventListener('resize',chkIm);whenReady(chkIm);
  // ===== intro: mali logo na narančastoj (fade in), ploha se povuče u gornji desni kut, pa se spusti logo s menijem =====
  const intro=$('#intro');
  const heroIn=()=>{$$('.hero .over, .hero .h, .hero .lang, .scrollhint').forEach(el=>el.classList.add('in'));startSlider()};
  const revealAll=()=>{revealQ.splice(0).forEach(f=>f());$$('.about .over').forEach(el=>{if(el.getBoundingClientRect().bottom<=innerHeight)el.classList.add('in')})};
  $$('.hero .over').forEach(el=>el.classList.add('fx'));$('.hero .over').style.setProperty('--d','500ms');
  if(reduce||!intro){intro&&intro.remove();document.body.classList.remove('intro');heroIn();revealAll()}
  else{
    scrollTo(0,0);
    const go=()=>{
      if(intro.dataset.go||!document.body.contains(intro))return;intro.dataset.go=1;
      document.body.classList.add('brandwait');document.body.classList.remove('intro');
      intro.classList.add('go');
      setTimeout(heroIn,500);
      setTimeout(()=>{intro.remove();document.body.classList.remove('brandwait');setTimeout(revealAll,250)},1250);
    };
    // preloader: čeka da se učitaju sve slike, fontovi i stranica (najmanje 1,2 s zbog fade ina)
    const t0=performance.now(), bar=$('#ibar');
    const imgs=$$('img').filter(i=>!intro.contains(i));
    let done=0;const total=imgs.length+1;
    const tick=()=>{done++;bar.style.transform=`scaleX(${Math.min(1,done/total)})`};
    const imgReady=imgs.map(i=>i.complete&&i.naturalWidth?(tick(),Promise.resolve()):new Promise(r=>{const f=()=>{tick();r()};i.addEventListener('load',f,{once:true});i.addEventListener('error',f,{once:true})}));
    const fontsReady=(document.fonts?document.fonts.ready:Promise.resolve()).then(tick);
    const pageReady=new Promise(r=>document.readyState==='complete'?r():addEventListener('load',r,{once:true}));
    Promise.all([...imgReady,fontsReady,pageReady]).then(()=>{bar.style.transform='scaleX(1)';setTimeout(go,Math.max(450,1200-(performance.now()-t0)))});
    setTimeout(go,20000); // sigurnosni izlaz ako nešto zapne
  }
}
