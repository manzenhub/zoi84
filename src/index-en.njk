.chips button{height:calc(64*var(--u));min-height:44px;padding:0 calc(22*var(--u));border-radius:30px;border:1.5px solid #D6D6D6;background:transparent;color:var(--bk);font:600 calc(15*var(--u)) 'Poppins';font-size:max(13px,calc(15*var(--u)));cursor:pointer;transition:background .2s,color .2s,border-color .2s}
