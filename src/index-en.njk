.nav li a{display:inline-block;font-family:var(--hf);font-size:clamp(40px,min(5vw,8.2vh),96px);line-height:1.22;padding-top:.08em;text-transform:uppercase;transform:translateY(110%);opacity:0;transition:transform .25s ease-in,opacity .2s}
.nav.open li a{transform:none;opacity:1;transition:transform .8s cubic-bezier(.19,1,.22,1),opacity .6s;transition-delay:calc(.35s + var(--n) * .12s)}
.nav li:nth-child(1){--n:0}.nav li:nth-child(2){--n:1}.nav li:nth-child(3){--n:2}.nav li:nth-child(4){--n:3}.nav li:nth-child(5){--n:4}.nav li:nth-child(6){--n:5}.nav li:nth-child(7){--n:6}.nav li:nth-child(8){--n:7}
.nav.open li a{opacity:.8}.nav.open li a.on{opacity:1}
.nav.open ul a:hover{opacity:1;transition-delay:0s}
.nav aside{font-size:16px;line-height:1.7;opacity:0;transition:opacity .3s}.nav.open aside{opacity:1;transition:opacity .6s 1.1s}
