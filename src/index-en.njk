<script>
{
  const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  // menu
  const brand=$('#brand'), nav=$('#nav'), mb=$('#mb');
  const setNav=o=>{brand.classList.toggle('open',o);nav.classList.toggle('open',o);nav.inert=!o;mb.setAttribute('aria-expanded',o);document.body.style.overflow=o?'hidden':''};
  mb.addEventListener('click',()=>setNav(!nav.classList.contains('open')));
  $$('#nav a').forEach(a=>a.addEventListener('click',()=>setNav(false)));
  document.addEventListener('keydown',e=>{if(e.key==='Escape')setNav(false)});
  // hero: tri fotografije (skijanje, košarka, koncerti) se izmjenjuju
  const slides=$$('.slide'); let cur=0;
  const show=i=>{cur=i;slides.forEach((s,k)=>s.classList.toggle('on',k===i))};
  const startSlider=()=>{if(!reduce&&!window._sl)window._sl=setInterval(()=>show((cur+1)%slides.length),1500)};
  // reveal
  // ===== pojavljivanje elemenata =====
  // svi naslovi i prvi paragraf: stvarni redovi (riječi grupirane po visini), red po red s blurom
  const lineSplit=el=>{if(!el.dataset.src)el.dataset.src=el.innerHTML.trim();
    const segs=el.dataset.src.split(/<br\s*\/?>/i).map(t=>t.replace(/<[^>]+>/g,'').trim());
    el.innerHTML=segs.map(t=>t.split(/\s+/).map(w=>`<span class="w" style="white-space:nowrap">${w}</span>`).join(' ')).join('<br>');
    const rows=[];let top=null;el.querySelectorAll('.w').forEach(w=>{const t=w.offsetTop;if(top===null||Math.abs(t-top)>4){rows.push([]);top=t}rows[rows.length-1].push(w.textContent)});
    el.innerHTML=rows.map((r,i)=>`<span class="ln"><span style="--i:${i}">${r.join(' ')}</span></span>`).join('')};
  const lp=$$('h1.h, h2.h, .gw .h, .dj .h, .dir .nm, .about .st');
  $$('.about .st').forEach(el=>el.style.setProperty('--d','150ms'));
  const doLines=()=>lp.forEach(lineSplit);
  (document.fonts?document.fonts.ready:Promise.resolve()).then(doLines);
  let rt,lw=innerWidth;addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(()=>{if(innerWidth!==lw){lw=innerWidth;doLines()}},200)});
  const mark=(sel,cls,step=0,base=0)=>$$(sel).forEach((el,i)=>{el.classList.add(cls);if(step||base)el.style.setProperty('--d',(base+i*step)+'ms')});
  const group=(parentSel,childSel,cls,step,base=0)=>$$(parentSel).forEach(p=>[...p.querySelectorAll(childSel)].forEach((el,i)=>{el.classList.add(cls);el.style.setProperty('--d',(base+i*step)+'ms')}));
  mark('.over','fx');
  mark('.games .tx2 p, .head .lead, .dir blockquote, .ftop p','fu',0,250);
