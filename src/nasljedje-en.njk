<script>
{
  const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
  const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  const brand=$('#brand'), nav=$('#nav'), mb=$('#mb');
  const setNav=o=>{brand.classList.toggle('open',o);nav.classList.toggle('open',o);nav.inert=!o;mb.setAttribute('aria-expanded',o);document.body.style.overflow=o?'hidden':''};
  mb.addEventListener('click',()=>setNav(!nav.classList.contains('open')));
  $$('#nav a').forEach(a=>a.addEventListener('click',()=>setNav(false)));
  document.addEventListener('keydown',e=>{if(e.key==='Escape')setNav(false)});
  // naslovi red po red
  const lineSplit=el=>{if(!el.dataset.src)el.dataset.src=el.innerHTML.trim();
    const segs=el.dataset.src.split(/<br\s*\/?>/i).map(t=>t.replace(/<[^>]+>/g,'').trim());
    el.innerHTML=segs.map(t=>t.split(/\s+/).map(w=>`<span class="w" style="white-space:nowrap">${w}</span>`).join(' ')).join('<br>');
    const rows=[];let top=null;el.querySelectorAll('.w').forEach(w=>{const t=w.offsetTop;if(top===null||Math.abs(t-top)>4){rows.push([]);top=t}rows[rows.length-1].push(w.textContent)});
    el.innerHTML=rows.map((r,i)=>`<span class="ln"><span style="--i:${i}">${r.join(' ')}</span></span>`).join('')};
  const lp=$$('h1.h, h2.h, .gw .h');
  const fit=el=>{if(el.dataset.desk){if(!el.dataset.mob)el.dataset.mob=el.innerHTML.trim();el.dataset.src=innerWidth>900?el.dataset.desk:el.dataset.mob}if(!el.dataset.src)el.dataset.src=el.innerHTML.trim();const segs=el.dataset.src.split(/<br\s*\/?>/i).map(t=>t.replace(/<[^>]+>/g,'').trim());
    const t=document.createElement('span');t.style.cssText='position:absolute;visibility:hidden;white-space:nowrap;font-size:100px';el.appendChild(t);
    let mw=0;segs.forEach(x=>{t.textContent=x;mw=Math.max(mw,t.getBoundingClientRect().width)});t.remove();
    const cs=getComputedStyle(el.parentElement),w=el.parentElement.clientWidth-parseFloat(cs.paddingLeft)-parseFloat(cs.paddingRight);
    el.style.fontSize=(100*w/mw*.98).toFixed(1)+'px'};
  // mobitel: medalja između "Volimo Jureka" i "više od bureka!"
  // medalja između redova naslova: desktop iza "Volimo Jureka", mobitel iza "Jureka"
  const placeJure=()=>{const sec=$('#jure');if(!sec)return;const h=sec.querySelector('.h'),st=sec.querySelector('.stage'),md=$('#medal3d');
    const mob=innerWidth<=900,ls=h.querySelectorAll('.ln'),idx=mob?2:1;if(ls.length<=idx)return;
    const W=md.offsetWidth,H=md.offsetHeight,asp=W/H,halfH=Math.max(.62,.62/asp),VEL=mob?1.11:.852,gy=-halfH+VEL*.53+.02;
    const med=VEL/(2*halfH)*H,cen=H/2-gy/(2*halfH)*H,medTop=cen-med/2,pad=mob?innerWidth*.04:H*.06,extra=mob?innerWidth*.06:H*.05;
    h.style.setProperty('--jg',Math.round(med+pad*2+extra)+'px');
    const lb=ls[idx-1].getBoundingClientRect().bottom-sec.getBoundingClientRect().top;
    st.style.setProperty('top',Math.round(lb+pad-medTop)+'px','important')};
  const doLines=()=>{$$('.ob .h').forEach(fit);lp.forEach(lineSplit);placeJure()};
  (document.fonts?document.fonts.ready:Promise.resolve()).then(doLines);
  let rt,lw=innerWidth;addEventListener('resize',()=>{clearTimeout(rt);rt=setTimeout(()=>{if(innerWidth!==lw){lw=innerWidth;doLines()}},200)});
  const mark=(sel,cls,step=0,base=0)=>$$(sel).forEach((el,i)=>{el.classList.add(cls);if(step||base)el.style.setProperty('--d',(base+i*step)+'ms')});
  const group=(parentSel,childSel,cls,step,base=0)=>$$(parentSel).forEach(p=>[...p.querySelectorAll(childSel)].forEach((el,i)=>{el.classList.add(cls);el.style.setProperty('--d',(base+i*step)+'ms')}));
  mark('.over','fx');
  mark('.pp, .head .lead, .ftop p, .ob .cap3, .big p, .games .tx2 p','fu',0,250);
  mark('.ftop .btn, .ob small, .close small','fu',0,450);
  mark('.ob .stage','fu',0,200);
  mark('.lang','fu');
  group('.ngrid','.ngrid>div','fu',120);
  mark('.big b','fu',0,150);
  $$('.arch').forEach(el=>el.classList.add('ph'));
  group('.cards','.gw','ph',200);
  group('.clist','li','fu',110,200);
  group('.fcols','.fcols>div','fu',110);
  mark('.fbot','fu',0,200);
  const heads=lp.filter(h=>!h.closest('.hero'));
  // brojke se odbrojavaju
  const fmt=n=>Math.round(n).toLocaleString('de-DE');
  const count=el=>{const to=+el.dataset.to,suf=el.dataset.suffix||'';if(reduce){el.textContent=fmt(to)+suf;return}const t0=performance.now(),D=1800;const f=t=>{const p=Math.min(1,(t-t0)/D),e=1-Math.pow(1-p,4);el.textContent=fmt(to*e)+suf;if(p<1)requestAnimationFrame(f)};requestAnimationFrame(f)};
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const el=e.target;el.classList.add('in');io.unobserve(el);
    const d=parseFloat(el.style.getPropertyValue('--d'))||0;setTimeout(()=>el.style.setProperty('--d','0ms'),d+1600)}),{threshold:.18,rootMargin:'0px 0px -6% 0px'});
  const revealQ=[];const whenReady=f=>revealQ.push(f);
  whenReady(()=>[...heads,...$$('.fu,.fx,.ph')].filter(el=>!el.closest('.hero')).forEach(el=>io.observe(el)));
  // paralaksa: elementi lebde različitim brzinama
  const SP=[];
  const px=[];SP.forEach(([sel,sp])=>$$(sel).forEach(el=>{el.dataset.sp=sp;px.push(el)}));
  const mob=()=>innerWidth<=900;
  const para=()=>{if(reduce)return;const k=mob()?.5:1,vh=innerHeight;px.forEach(el=>{const r=el.getBoundingClientRect();
    const base=r.top+r.height/2-(parseFloat(el.style.getPropertyValue('--pz'))||0);if(base<-vh||base>vh*2)return;
    el.style.setProperty('--pz',(-(base-vh/2)*el.dataset.sp*k).toFixed(1)+'px')})};
  let raf=0;addEventListener('scroll',()=>{if(!raf)raf=requestAnimationFrame(()=>{raf=0;para()})},{passive:true});addEventListener('resize',para);para();
  // slider brojki
  {const tr=$('#nstrack');if(tr){const sl=[...tr.children],n=sl.length,c=$('#nsc'),bar=$('#nsbar');
    const idx=()=>Math.round(tr.scrollLeft/tr.clientWidth);
    const upd=()=>{const i=Math.min(n-1,Math.max(0,idx()));c.textContent=String(i+1).padStart(2,'0')+' / '+String(n).padStart(2,'0');bar.style.transform=`scaleX(${(i+1)/n})`;sl.forEach((s,k)=>s.classList.toggle('on',k===i))};
    const go=i=>tr.scrollTo({left:Math.max(0,Math.min(n-1,i))*tr.clientWidth,behavior:'smooth'});
    $('#nsn').addEventListener('click',()=>go(idx()+1));$('#nsp').addEventListener('click',()=>go(idx()-1));
    tr.addEventListener('scroll',()=>requestAnimationFrame(upd),{passive:true});upd();
    let down=false,sx=0,sl0=0,mv=false;
    tr.addEventListener('pointerdown',e=>{if(e.pointerType!=='mouse'||e.button!==0)return;down=true;mv=false;sx=e.clientX;sl0=tr.scrollLeft});
    addEventListener('pointermove',e=>{if(!down)return;const dx=e.clientX-sx;if(!mv&&Math.abs(dx)>5){mv=true;tr.classList.add('drag')}if(mv){tr.scrollLeft=sl0-dx;e.preventDefault()}});
    addEventListener('pointerup',e=>{if(!down)return;down=false;if(mv){tr.classList.remove('drag');const dx=e.clientX-sx;go(Math.abs(dx)>tr.clientWidth*.12?idx0(dx):idx())}});
    const idx0=dx=>Math.round(sl0/tr.clientWidth)+(dx<0?1:-1);
    tr.addEventListener('dragstart',e=>e.preventDefault());
  }}
  // skrol: paralaksa bannera, baklja, medalja se okreće, ulaznica se naginje
  const prog=el=>{const r=el.getBoundingClientRect();return Math.max(0,Math.min(1,(innerHeight-r.top)/(innerHeight+r.height)))};
  const bands=$$('.band'), torch=null, medal=$('#medal'), ticket=$('#ticket');
  let mx=0,my=0;
  const onScroll=()=>{if(reduce)return;
    if(medal){const p=prog(medal.closest('section'));medal.style.setProperty('--ry',((p-.5)*360).toFixed(1)+'deg')}
    if(ticket){const p=prog(ticket.closest('section'));ticket.style.setProperty('--rx',(26-p*24+my*8).toFixed(1)+'deg');ticket.style.setProperty('--ry',(-24+p*30+mx*10).toFixed(1)+'deg');ticket.style.setProperty('--rz',(-10+p*12).toFixed(1)+'deg')}
  };
  // fotografije: narančasta ploha pa slika (kao na naslovnoj)
  $$('.im').forEach(el=>el.insertAdjacentHTML('beforeend','<span class="cov" aria-hidden="true"></span>'));
  let pend=$$('.im');
  const chkIm=()=>{if(!pend.length)return;const lim=innerHeight*.88;pend=pend.filter(c=>{const r=c.getBoundingClientRect();if(r.top<lim&&r.bottom>0){c.classList.add('in');const d=parseFloat(c.style.getPropertyValue('--d'))||0;setTimeout(()=>{c.classList.add('done');c.style.setProperty('--d','0ms')},d+1700);return false}return true})};
  addEventListener('scroll',chkIm,{passive:true});addEventListener('resize',chkIm);whenReady(chkIm);
  const halfs=[];
  const half=()=>{if(reduce)return;const vh=innerHeight;halfs.forEach(el=>{const host=el.closest('.band,.hero');const r=host.getBoundingClientRect();if(r.bottom<-50||r.top>vh+50)return;
    const v=host.classList.contains('hero')?Math.max(0,-r.top)*.5:-(r.top+r.height/2-vh/2)*.5;el.style.setProperty('--py',v.toFixed(1)+'px')})};
  let hq=0;addEventListener('scroll',()=>{if(!hq)hq=requestAnimationFrame(()=>{hq=0;half()})},{passive:true});addEventListener('resize',half);half();
  addEventListener('scroll',onScroll,{passive:true});addEventListener('resize',onScroll);onScroll();
  if(ticket){const sec=ticket.closest('section');sec.addEventListener('pointermove',e=>{if(e.pointerType!=='mouse')return;const r=sec.getBoundingClientRect();mx=(e.clientX-r.left)/r.width-.5;my=(e.clientY-r.top)/r.height-.5;onScroll()});sec.addEventListener('pointerleave',()=>{mx=my=0;onScroll()})}
  // preloader + intro (isti kao na naslovnoj)
  const intro=$('#intro');
  const heroIn=()=>$$('.hero .over, .hero .h, .hero .lang, .scrollhint').forEach(el=>el.classList.add('in'));
  const revealAll=()=>revealQ.splice(0).forEach(f=>f());
  
  if(reduce||!intro){intro&&intro.remove();document.body.classList.remove('intro');heroIn();revealAll()}
  else{
    scrollTo(0,0);
    const go=()=>{
      if(intro.dataset.go||!document.body.contains(intro))return;intro.dataset.go=1;
      document.body.classList.add('brandwait');document.body.classList.remove('intro');
      intro.classList.add('go');
      setTimeout(heroIn,500);
      setTimeout(()=>{intro.remove();document.body.classList.remove('brandwait');setTimeout(revealAll,250)},1250);
    };
    const t0=performance.now(), bar=$('#ibar');
    const imgs=$$('img').filter(i=>!intro.contains(i));
    let done=0;const total=imgs.length+1;
    const tick=()=>{done++;bar.style.transform=`scaleX(${Math.min(1,done/total)})`};
    const imgReady=imgs.map(i=>i.complete&&i.naturalWidth?(tick(),Promise.resolve()):new Promise(r=>{const f=()=>{tick();r()};i.addEventListener('load',f,{once:true});i.addEventListener('error',f,{once:true})}));
    const fontsReady=(document.fonts?document.fonts.ready:Promise.resolve()).then(tick);
    const pageReady=new Promise(r=>document.readyState==='complete'?r():addEventListener('load',r,{once:true}));
    Promise.all([...imgReady,fontsReady,pageReady]).then(()=>{bar.style.transform='scaleX(1)';setTimeout(go,Math.max(450,1200-(performance.now()-t0)))});
    setTimeout(go,20000);
  }
}
</script>
